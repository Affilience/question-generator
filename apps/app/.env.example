# OpenAI API Key for question generation AND blog generation
# For questions: Falls back if GROQ_API_KEY not set
# For blog generation: Primary API for generating 1000+ educational blog posts
# Cost: ~$1.91 for 1000 blog posts with GPT-4o Mini
# Get API key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-api-key-here

# Groq API Key for FAST question generation (recommended)
# Get free API key at: https://console.groq.com
# Groq is 5-10x faster than OpenAI and cheaper
# If not set, falls back to OpenAI
GROQ_API_KEY=gsk_your-groq-api-key-here

# Upstash Redis for question caching (optional but recommended)
# Get free tier at: https://upstash.com
# Without these, caching is disabled and every request generates a new question
UPSTASH_REDIS_REST_URL=https://your-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token-here

# Fine-tuned models (optional - train on real past papers for exam-quality questions)
# Run: npx tsx scripts/fine-tuning/train.ts to create these
# Format: FINE_TUNED_MODEL_{SUBJECT}_{LEVEL}_{BOARD}
# FINE_TUNED_MODEL_MATHS_GCSE_AQA=ft:gpt-4o-mini-2024-07-18:personal::xxxxx
# FINE_TUNED_MODEL_MATHS_GCSE_EDEXCEL=ft:gpt-4o-mini-2024-07-18:personal::xxxxx
# FINE_TUNED_MODEL_PHYSICS_GCSE_AQA=ft:gpt-4o-mini-2024-07-18:personal::xxxxx
# FINE_TUNED_MODEL_CHEMISTRY_GCSE_AQA=ft:gpt-4o-mini-2024-07-18:personal::xxxxx

# Sentry Error Tracking (recommended for production)
# Create a free account at: https://sentry.io
# Go to Settings > Projects > [Your Project] > Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=your-sentry-project
# Auth token for source map uploads (Settings > Auth Tokens)
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# Owner accounts with unlimited access (comma-separated, case-insensitive)
OWNER_EMAILS=

# ---------------------------------------------------------------------------
# Supabase (required - the app cannot boot without these)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key
# Server-only. Bypasses row-level security - never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Stripe
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_live_or_test_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_or_test_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
STRIPE_PRICE_STUDENT_PLUS_MONTHLY=price_xxx
STRIPE_PRICE_STUDENT_PLUS_ANNUAL=price_xxx
STRIPE_PRICE_EXAM_PRO_MONTHLY=price_xxx
STRIPE_PRICE_EXAM_PRO_ANNUAL=price_xxx

# ---------------------------------------------------------------------------
# Email (Resend)
# ---------------------------------------------------------------------------
RESEND_API_KEY=re_your_api_key
# Where unclaimed-purchase digests are sent
ADMIN_ALERT_EMAIL=you@example.com

# ---------------------------------------------------------------------------
# Background paper generation (Upstash QStash)
# ---------------------------------------------------------------------------
QSTASH_TOKEN=your-qstash-token
QSTASH_CURRENT_SIGNING_KEY=sig_current
QSTASH_NEXT_SIGNING_KEY=sig_next

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Absolute origin, used for Stripe redirects and email links
NEXT_PUBLIC_APP_URL=https://www.past-papers.co.uk
# Shared secret for the scheduled unclaimed-subscription digest. Compared with
# a timing-safe check; the route fails closed when this is unset.
CRON_SECRET=generate-a-long-random-value
# Gates /api/stripe/debug. The route fails closed when this is unset, so leaving
# it blank simply disables that endpoint.
DEBUG_TOKEN=
# Grants unlimited generation to internal callers (prewarm/seed scripts) via the
# x-internal-key header on /api/generate-question. Leave blank to disable.
INTERNAL_API_KEY=
